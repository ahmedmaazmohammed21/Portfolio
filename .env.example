# Public site URL, set this to the deployed URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access: use a long unique password and at least 32 random characters for the session secret
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase project -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key

# GitHub username whose public activity can be imported in the admin dashboard
GITHUB_USERNAME=ahmedmaazmohammed21
